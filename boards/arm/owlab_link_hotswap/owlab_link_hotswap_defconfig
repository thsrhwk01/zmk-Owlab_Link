CONFIG_BOARD_OWLAB_LINK_HOTSWAP=y
CONFIG_SOC_SERIES_STM32F1X=y
CONFIG_SOC_STM32F103XB=y

# 72MHz system clock
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=72000000

# enable PINMUX
CONFIG_PINCTRL=y

# enable GPIO
CONFIG_GPIO=y

# ZMK Settings
CONFIG_ZMK_USB=y
# CONFIG_ZMK_KSCAN_MATRIX_POLLING=y
CONFIG_USB_SELF_POWERED=n

# clock configuration
CONFIG_CLOCK_CONTROL=y

# Link the application into the code partition declared in devicetree.
CONFIG_USE_DT_CODE_PARTITION=y

# The factory DFU chain-loads the application without a Cortex-M system reset.
# Restore CONTROL, SysTick, NVIC priorities, enables, and pending state before
# Zephyr starts so bootloader USB interrupts cannot leak into the application.
CONFIG_INIT_ARCH_HW_AT_BOOT=y
